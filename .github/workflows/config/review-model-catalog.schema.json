{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocr-app.example.invalid/schemas/review-model-catalog-v1.schema.json",
  "title": "TrustedReviewModelCatalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "models",
    "strategies",
    "unknown_risk_strategy"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "strategies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast",
        "deep"
      ],
      "properties": {
        "fast": {
          "$ref": "#/$defs/strategy"
        },
        "deep": {
          "$ref": "#/$defs/strategy"
        }
      }
    },
    "unknown_risk_strategy": {
      "const": "deep"
    }
  },
  "$defs": {
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_model_id"
      ],
      "properties": {
        "preferred_model_id": {
          "$ref": "#/$defs/model_id"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "capability_tier",
        "certification_status",
        "certification_reference",
        "allowed_fallbacks",
        "catalog_version"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/model_id"
        },
        "capability_tier": {
          "enum": [
            "fast",
            "deep"
          ]
        },
        "certification_status": {
          "enum": [
            "pending",
            "certified",
            "suspended",
            "revoked"
          ]
        },
        "certification_reference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "allowed_fallbacks": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/model_id"
          }
        },
        "catalog_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "certification_status": {
                "const": "certified"
              }
            },
            "required": [
              "certification_status"
            ]
          },
          "then": {
            "properties": {
              "certification_reference": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "certification_reference": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
