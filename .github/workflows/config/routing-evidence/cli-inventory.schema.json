{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocr-app.example.invalid/schemas/cli-inventory-v1.schema.json",
  "title": "CliInventoryEvidence/v1",
  "description": "Stub schema for future trusted-runner collection; no CLI execution is performed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cli_version",
    "cli_binary_sha256",
    "models",
    "observed_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1"
      ]
    },
    "cli_version": {
      "type": "string",
      "minLength": 1
    },
    "cli_binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "models": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
